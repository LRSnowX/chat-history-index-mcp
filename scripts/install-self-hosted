#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
DATA_HOME="${CHAT_HISTORY_DATA_HOME:-$HOME/Library/Application Support/chat-history-index-mcp}"
INSTALL_PLUGIN=true

usage() { echo "usage: $0 [--data-home PATH] [--skip-plugin]" >&2; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --data-home) DATA_HOME="$2"; shift 2 ;;
    --skip-plugin) INSTALL_PLUGIN=false; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

if [ "$(uname -s)" != "Darwin" ]; then
  echo "The packaged installer currently supports macOS only." >&2
  exit 1
fi
for COMMAND in cargo git; do
  command -v "$COMMAND" >/dev/null 2>&1 || { echo "missing required command: $COMMAND" >&2; exit 1; }
done

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1090
  . "$HOME/.cargo/env"
fi

cargo build --release --manifest-path "$REPO_ROOT/Cargo.toml" --workspace
/bin/mkdir -p "$DATA_HOME/bin" "$DATA_HOME/db" "$DATA_HOME/cache" "$DATA_HOME/logs" "$DATA_HOME/sources" "$DATA_HOME/tmp"
/usr/bin/install -m 755 "$REPO_ROOT/target/release/chat-history-cli" "$DATA_HOME/bin/chat-history-cli"
/usr/bin/install -m 755 "$REPO_ROOT/target/release/chat-history-mcp" "$DATA_HOME/bin/chat-history-mcp"
/usr/bin/install -m 755 "$REPO_ROOT/scripts/chat-history-http-service" "$DATA_HOME/bin/chat-history-http-service"

if [ "$INSTALL_PLUGIN" = true ]; then
  command -v codex >/dev/null 2>&1 || { echo "Codex CLI is required unless --skip-plugin is used." >&2; exit 1; }
  MARKETPLACE_NAME="$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["name"])' "$REPO_ROOT/.agents/plugins/marketplace.json")"
  if ! codex plugin marketplace list --json | /usr/bin/python3 -c 'import json,sys,os; root=os.path.realpath(sys.argv[1]); data=json.load(sys.stdin).get("marketplaces", []); raise SystemExit(0 if any(os.path.realpath(str(x.get("root", ""))) == root for x in data) else 1)' "$REPO_ROOT"; then
    codex plugin marketplace add "$REPO_ROOT"
  fi
  codex plugin add "chat-history-index-mcp@$MARKETPLACE_NAME"
fi

echo "Installed binaries in $DATA_HOME/bin"
echo "Data home: $DATA_HOME"
echo "Run: $DATA_HOME/bin/chat-history-cli doctor"
