#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SERVICE="$SCRIPT_DIR/chatgpt-live-collector-service"

eval "$(grep '^APP_SERVER_PATTERN=' "$SERVICE")"

legacy='/Applications/ChatGPT.app/Contents/Resources/codex app-server'
current='/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex -c features.code_mode_host=true app-server --analytics-default-enabled'
unrelated='/Applications/Other.app/Contents/Resources/codex app-server'

printf '%s\n' "$legacy" | grep -Eq "$APP_SERVER_PATTERN"
printf '%s\n' "$current" | grep -Eq "$APP_SERVER_PATTERN"
if printf '%s\n' "$unrelated" | grep -Eq "$APP_SERVER_PATTERN"; then
  echo "app-server matcher accepted an unrelated application" >&2
  exit 1
fi

grep -q '^required = true$' "$SERVICE"
if grep -q '^required = false$' "$SERVICE"; then
  echo "ChatGPT live collector must be required so the app-server eagerly initializes it" >&2
  exit 1
fi

case_block() {
  local label="$1"
  awk -v label="$label" '
    $0 ~ "^  " label "\\)" { in_block=1 }
    in_block { print }
    in_block && /^    ;;/ { exit }
  ' "$SERVICE"
}

for command in install start restart; do
  block="$(case_block "$command")"
  if printf '%s\n' "$block" | grep -q 'restart_app_server'; then
    echo "$command must not restart the ChatGPT app-server" >&2
    exit 1
  fi
done

install_block="$(case_block install)"
if printf '%s\n' "$install_block" | grep -q 'stop_daemon'; then
  echo "install must preserve an already-running collector and its one-shot App Tools pipe" >&2
  exit 1
fi

restart_block="$(case_block restart)"
if printf '%s\n' "$restart_block" | grep -q 'stop_daemon'; then
  echo "restart must defer rather than destroy the current Desktop-scoped App Tools pipe" >&2
  exit 1
fi

echo "ChatGPT app-server matcher regression passed."
