#!/usr/bin/env bash
set -euo pipefail

DATA_HOME="${CHAT_HISTORY_DATA_HOME:-$HOME/Library/Application Support/chat-history-index-mcp}"
CONFIG="$HOME/.codex/config.toml"
CHATGPT_NODE="/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
COLLECTOR="$DATA_HOME/bin/chatgpt-live-collector.mjs"
STATUS="$DATA_HOME/cache/chatgpt-live-collector-status.json"
MEMORY_STATUS="$DATA_HOME/cache/memory-auto-compiler-status.json"
MEMORY_HISTORY="$DATA_HOME/cache/memory-auto-compiler-history.json"
DAEMON_LOCK="$DATA_HOME/cache/chatgpt-live-collector-daemon.lock"
LEGACY_LABEL="local.chat-history-index-chatgpt-sync"
LEGACY_PLIST="$HOME/Library/LaunchAgents/$LEGACY_LABEL.plist"
BEGIN_MARKER="# BEGIN chat-history-index-mcp ChatGPT live collector"
END_MARKER="# END chat-history-index-mcp ChatGPT live collector"
APP_SERVER_PATTERN='/Applications/ChatGPT\.app/Contents/Resources/(codex|codex-cli/.*/codex) .*app-server'

usage() {
  echo "usage: $0 install [--interval SECONDS] [--memory-projects CSV] [--memory-model MODEL] [--memory-scan-limit N] [--memory-max-conversations N] [--memory-max-messages N] [--memory-max-pending-candidates N] | start | stop | restart | status | uninstall" >&2
}

app_server_pid() {
  pgrep -f "$APP_SERVER_PATTERN" | head -1 || true
}

daemon_pid() {
  [ -f "$DAEMON_LOCK/pid" ] || return 0
  cat "$DAEMON_LOCK/pid" 2>/dev/null || true
}

pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

remove_legacy_launch_agent() {
  launchctl bootout "gui/$(id -u)/$LEGACY_LABEL" >/dev/null 2>&1 || true
  launchctl remove "$LEGACY_LABEL" >/dev/null 2>&1 || true
  rm -f "$LEGACY_PLIST"
}

stop_daemon() {
  local pid
  pid="$(daemon_pid)"
  if pid_alive "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 100); do
      pid_alive "$pid" || break
      sleep 0.05
    done
  fi
  if pid_alive "$pid"; then
    echo "ChatGPT live collector daemon did not stop cleanly (pid $pid)" >&2
    return 1
  fi
  rm -rf "$DAEMON_LOCK"
}

restart_app_server() {
  local old new
  old="$(app_server_pid)"
  if [ -z "$old" ]; then
    echo "ChatGPT.app is not running; the collector will bootstrap automatically on the next app launch."
    return 0
  fi
  kill -TERM "$old"
  new=""
  for _ in $(seq 1 100); do
    sleep 0.1
    new="$(app_server_pid)"
    [ -n "$new" ] && [ "$new" != "$old" ] && break
  done
  [ -n "$new" ] && [ "$new" != "$old" ] || { echo "ChatGPT app-server did not restart" >&2; return 1; }
  echo "Restarted ChatGPT app-server: $old -> $new"
}

write_config() {
  local interval_ms="$1"
  local memory_projects="$2"
  local memory_scan_limit="$3"
  local memory_max_conversations="$4"
  local memory_max_messages="$5"
  local memory_max_pending_candidates="$6"
  local memory_model="$7"
  mkdir -p "$HOME/.codex"
  touch "$CONFIG"
  /usr/bin/python3 - "$CONFIG" "$CHATGPT_NODE" "$COLLECTOR" "$DATA_HOME" "$interval_ms" "$memory_projects" "$memory_scan_limit" "$memory_max_conversations" "$memory_max_messages" "$memory_max_pending_candidates" "$memory_model" "$BEGIN_MARKER" "$END_MARKER" <<'PY'
from pathlib import Path
import json, os, shutil, stat, sys, time

(
    config,
    node,
    collector,
    data_home,
    interval_ms,
    memory_projects,
    memory_scan_limit,
    memory_max_conversations,
    memory_max_messages,
    memory_max_pending_candidates,
    memory_model,
    begin,
    end,
) = sys.argv[1:]
path = Path(config)
text = path.read_text() if path.exists() else ""
mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
lines = text.splitlines()
out = []
skip = False
in_marked = False
for line in lines:
    stripped = line.strip()
    if stripped == begin:
        in_marked = True
        continue
    if stripped == end:
        in_marked = False
        continue
    if in_marked:
        continue
    if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}:
        skip = True
        continue
    if skip and stripped.startswith("["):
        if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}:
            continue
        skip = False
    if not skip:
        out.append(line)

while out and not out[-1].strip():
    out.pop()
memory_env = ""
if memory_projects.strip():
    memory_env = (
        f"CHAT_HISTORY_MEMORY_AUTO_PROJECTS = {json.dumps(memory_projects)}\n"
        f"CHAT_HISTORY_MEMORY_AUTO_SCAN_LIMIT = {json.dumps(memory_scan_limit)}\n"
        f"CHAT_HISTORY_MEMORY_AUTO_MAX_CONVERSATIONS = {json.dumps(memory_max_conversations)}\n"
        f"CHAT_HISTORY_MEMORY_AUTO_MAX_MESSAGES = {json.dumps(memory_max_messages)}\n"
        f"CHAT_HISTORY_MEMORY_AUTO_MAX_PENDING_CANDIDATES = {json.dumps(memory_max_pending_candidates)}\n"
    )
    if memory_model.strip():
        memory_env += f"CHAT_HISTORY_MEMORY_MODEL = {json.dumps(memory_model)}\n"
block = f'''{begin}
[mcp_servers.chatgpt_live_collector]
command = "{node}"
env_vars = ["CODEX_APP_TOOLS_PIPE_PATH"]
args = ["{collector}", "--mcp-sidecar"]
startup_timeout_sec = 30
required = false

[mcp_servers.chatgpt_live_collector.env]
CHAT_HISTORY_DATA_HOME = "{data_home}"
CHAT_HISTORY_CHATGPT_POLL_INTERVAL_MS = "{interval_ms}"
{memory_env.rstrip()}
{end}'''
new_text = "\n".join(out) + ("\n\n" if out else "") + block + "\n"
if new_text != text:
    backup = path.with_name(f"config.pre-chatgpt-live-{time.strftime('%Y%m%dT%H%M%S')}.toml")
    if path.exists() and path.stat().st_size:
        shutil.copy2(path, backup)
        print(f"backup={backup}")
    path.write_text(new_text)
    os.chmod(path, mode)
PY
}

remove_config() {
  /usr/bin/python3 - "$CONFIG" "$BEGIN_MARKER" "$END_MARKER" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
if not path.exists(): raise SystemExit(0)
begin, end = sys.argv[2:]
lines = path.read_text().splitlines()
out=[]; skip=False; marked=False
for line in lines:
    stripped=line.strip()
    if stripped==begin: marked=True; continue
    if stripped==end: marked=False; continue
    if marked: continue
    if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}:
        skip=True; continue
    if skip and stripped.startswith("["):
        if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}: continue
        skip=False
    if not skip: out.append(line)
path.write_text("\n".join(out).rstrip()+"\n")
PY
}

COMMAND="${1:-}"
[ -n "$COMMAND" ] || { usage; exit 2; }
shift

case "$COMMAND" in
  install)
    INTERVAL=120
    MEMORY_PROJECTS=""
    MEMORY_SCAN_LIMIT=500
    MEMORY_MAX_CONVERSATIONS=1
    MEMORY_MAX_MESSAGES=8
    MEMORY_MAX_PENDING_CANDIDATES=20
    MEMORY_MODEL=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --interval) INTERVAL="$2"; shift 2 ;;
        --memory-projects) MEMORY_PROJECTS="$2"; shift 2 ;;
        --memory-model) MEMORY_MODEL="$2"; shift 2 ;;
        --memory-scan-limit) MEMORY_SCAN_LIMIT="$2"; shift 2 ;;
        --memory-max-conversations) MEMORY_MAX_CONVERSATIONS="$2"; shift 2 ;;
        --memory-max-messages) MEMORY_MAX_MESSAGES="$2"; shift 2 ;;
        --memory-max-pending-candidates) MEMORY_MAX_PENDING_CANDIDATES="$2"; shift 2 ;;
        *) usage; exit 2 ;;
      esac
    done
    [[ "$INTERVAL" =~ ^[0-9]+$ ]] && [ "$INTERVAL" -ge 30 ] || { echo "--interval must be an integer >= 30" >&2; exit 2; }
    [[ "$MEMORY_SCAN_LIMIT" =~ ^[0-9]+$ ]] && [ "$MEMORY_SCAN_LIMIT" -ge 1 ] && [ "$MEMORY_SCAN_LIMIT" -le 1000 ] || { echo "--memory-scan-limit must be an integer from 1 to 1000" >&2; exit 2; }
    [[ "$MEMORY_MAX_CONVERSATIONS" =~ ^[0-9]+$ ]] && [ "$MEMORY_MAX_CONVERSATIONS" -ge 1 ] && [ "$MEMORY_MAX_CONVERSATIONS" -le 10 ] || { echo "--memory-max-conversations must be an integer from 1 to 10" >&2; exit 2; }
    [[ "$MEMORY_MAX_MESSAGES" =~ ^[0-9]+$ ]] && [ "$MEMORY_MAX_MESSAGES" -ge 1 ] && [ "$MEMORY_MAX_MESSAGES" -le 16 ] || { echo "--memory-max-messages must be an integer from 1 to 16" >&2; exit 2; }
    [[ "$MEMORY_MAX_PENDING_CANDIDATES" =~ ^[0-9]+$ ]] && [ "$MEMORY_MAX_PENDING_CANDIDATES" -ge 8 ] && [ "$MEMORY_MAX_PENDING_CANDIDATES" -le 100 ] || { echo "--memory-max-pending-candidates must be an integer from 8 to 100" >&2; exit 2; }
    if [ -n "$MEMORY_MODEL" ] && [ -z "$MEMORY_PROJECTS" ]; then
      echo "--memory-model requires --memory-projects" >&2
      exit 2
    fi
    if [ -n "$MEMORY_PROJECTS" ] && [ -z "$MEMORY_MODEL" ]; then
      echo "--memory-projects requires --memory-model" >&2
      exit 2
    fi
    [ -x "$CHATGPT_NODE" ] || { echo "ChatGPT.app bundled Node is missing: $CHATGPT_NODE" >&2; exit 1; }
    [ -f "$COLLECTOR" ] || { echo "run scripts/install-self-hosted first" >&2; exit 1; }
    remove_legacy_launch_agent
    write_config "$((INTERVAL * 1000))" "$MEMORY_PROJECTS" "$MEMORY_SCAN_LIMIT" "$MEMORY_MAX_CONVERSATIONS" "$MEMORY_MAX_MESSAGES" "$MEMORY_MAX_PENDING_CANDIDATES" "$MEMORY_MODEL"
    stop_daemon
    restart_app_server
    if [ -n "$MEMORY_PROJECTS" ]; then
      echo "Installed ChatGPT live collector (interval ${INTERVAL}s, memory auto projects: $MEMORY_PROJECTS)."
    else
      echo "Installed ChatGPT live collector (interval ${INTERVAL}s, memory auto compiler disabled)."
    fi
    ;;
  start)
    remove_legacy_launch_agent
    pid="$(daemon_pid)"
    if pid_alive "$pid"; then
      echo "ChatGPT live collector daemon is already running (pid $pid)."
    else
      restart_app_server
    fi
    ;;
  stop)
    stop_daemon
    echo "Stopped ChatGPT live collector daemon. It will bootstrap again when ChatGPT app-server is restarted."
    ;;
  restart)
    remove_legacy_launch_agent
    stop_daemon
    restart_app_server
    ;;
  status)
    pid="$(daemon_pid)"
    if pid_alive "$pid"; then echo "daemon_pid=$pid running=true"; else echo "daemon_pid=${pid:-none} running=false"; fi
    if [ -f "$STATUS" ]; then cat "$STATUS"; else echo '{"state":"not-started"}'; fi
    if [ -f "$MEMORY_STATUS" ]; then
      echo "memory_auto_compiler:"
      cat "$MEMORY_STATUS"
    fi
    if [ -f "$MEMORY_HISTORY" ]; then
      echo "memory_auto_compiler_history:"
      cat "$MEMORY_HISTORY"
    fi
    ;;
  uninstall)
    remove_legacy_launch_agent
    stop_daemon
    remove_config
    restart_app_server
    echo "Removed ChatGPT live collector configuration; indexed history and sync state were preserved."
    ;;
  *) usage; exit 2 ;;
esac
