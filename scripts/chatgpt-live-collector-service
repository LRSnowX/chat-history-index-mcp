#!/usr/bin/env bash
set -euo pipefail

DATA_HOME="${CHAT_HISTORY_DATA_HOME:-$HOME/Library/Application Support/chat-history-index-mcp}"
CONFIG="$HOME/.codex/config.toml"
CHATGPT_NODE="/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
COLLECTOR="$DATA_HOME/bin/chatgpt-live-collector.mjs"
STATUS="$DATA_HOME/cache/chatgpt-live-collector-status.json"
DAEMON_LOCK="$DATA_HOME/cache/chatgpt-live-collector-daemon.lock"
BEGIN_MARKER="# BEGIN chat-history-index-mcp ChatGPT live collector"
END_MARKER="# END chat-history-index-mcp ChatGPT live collector"

usage() {
  echo "usage: $0 install [--interval SECONDS] | start | stop | restart | status | uninstall" >&2
}

app_server_pid() {
  pgrep -f '/Applications/ChatGPT.app/Contents/Resources/codex .*app-server' | head -1 || true
}

daemon_pid() {
  [ -f "$DAEMON_LOCK/pid" ] || return 0
  cat "$DAEMON_LOCK/pid" 2>/dev/null || true
}

pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

stop_daemon() {
  local pid
  pid="$(daemon_pid)"
  if pid_alive "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 100); do
      pid_alive "$pid" || break
      sleep 0.05
    done
  fi
  if pid_alive "$pid"; then
    echo "ChatGPT live collector daemon did not stop cleanly (pid $pid)" >&2
    return 1
  fi
  rm -rf "$DAEMON_LOCK"
}

restart_app_server() {
  local old new
  old="$(app_server_pid)"
  if [ -z "$old" ]; then
    echo "ChatGPT.app is not running; the collector will bootstrap automatically on the next app launch."
    return 0
  fi
  kill -TERM "$old"
  new=""
  for _ in $(seq 1 100); do
    sleep 0.1
    new="$(app_server_pid)"
    [ -n "$new" ] && [ "$new" != "$old" ] && break
  done
  [ -n "$new" ] && [ "$new" != "$old" ] || { echo "ChatGPT app-server did not restart" >&2; return 1; }
  echo "Restarted ChatGPT app-server: $old -> $new"
}

write_config() {
  local interval_ms="$1"
  mkdir -p "$HOME/.codex"
  touch "$CONFIG"
  /usr/bin/python3 - "$CONFIG" "$CHATGPT_NODE" "$COLLECTOR" "$DATA_HOME" "$interval_ms" "$BEGIN_MARKER" "$END_MARKER" <<'PY'
from pathlib import Path
import os, shutil, stat, sys, time

config, node, collector, data_home, interval_ms, begin, end = sys.argv[1:]
path = Path(config)
text = path.read_text() if path.exists() else ""
mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
lines = text.splitlines()
out = []
skip = False
in_marked = False
for line in lines:
    stripped = line.strip()
    if stripped == begin:
        in_marked = True
        continue
    if stripped == end:
        in_marked = False
        continue
    if in_marked:
        continue
    if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}:
        skip = True
        continue
    if skip and stripped.startswith("["):
        if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}:
            continue
        skip = False
    if not skip:
        out.append(line)

while out and not out[-1].strip():
    out.pop()
block = f'''{begin}
[mcp_servers.chatgpt_live_collector]
command = "{node}"
env_vars = ["CODEX_APP_TOOLS_PIPE_PATH"]
args = ["{collector}", "--mcp-sidecar"]
startup_timeout_sec = 30
required = false

[mcp_servers.chatgpt_live_collector.env]
CHAT_HISTORY_DATA_HOME = "{data_home}"
CHAT_HISTORY_CHATGPT_POLL_INTERVAL_MS = "{interval_ms}"
{end}'''
new_text = "\n".join(out) + ("\n\n" if out else "") + block + "\n"
if new_text != text:
    backup = path.with_name(f"config.pre-chatgpt-live-{time.strftime('%Y%m%dT%H%M%S')}.toml")
    if path.exists() and path.stat().st_size:
        shutil.copy2(path, backup)
        print(f"backup={backup}")
    path.write_text(new_text)
    os.chmod(path, mode)
PY
}

remove_config() {
  /usr/bin/python3 - "$CONFIG" "$BEGIN_MARKER" "$END_MARKER" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
if not path.exists(): raise SystemExit(0)
begin, end = sys.argv[2:]
lines = path.read_text().splitlines()
out=[]; skip=False; marked=False
for line in lines:
    stripped=line.strip()
    if stripped==begin: marked=True; continue
    if stripped==end: marked=False; continue
    if marked: continue
    if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}:
        skip=True; continue
    if skip and stripped.startswith("["):
        if stripped in {"[mcp_servers.chatgpt_live_collector]", "[mcp_servers.chatgpt_live_collector.env]"}: continue
        skip=False
    if not skip: out.append(line)
path.write_text("\n".join(out).rstrip()+"\n")
PY
}

COMMAND="${1:-}"
[ -n "$COMMAND" ] || { usage; exit 2; }
shift

case "$COMMAND" in
  install)
    INTERVAL=120
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --interval) INTERVAL="$2"; shift 2 ;;
        *) usage; exit 2 ;;
      esac
    done
    [[ "$INTERVAL" =~ ^[0-9]+$ ]] && [ "$INTERVAL" -ge 30 ] || { echo "--interval must be an integer >= 30" >&2; exit 2; }
    [ -x "$CHATGPT_NODE" ] || { echo "ChatGPT.app bundled Node is missing: $CHATGPT_NODE" >&2; exit 1; }
    [ -f "$COLLECTOR" ] || { echo "run scripts/install-self-hosted first" >&2; exit 1; }
    write_config "$((INTERVAL * 1000))"
    stop_daemon
    restart_app_server
    echo "Installed ChatGPT live collector (interval ${INTERVAL}s)."
    ;;
  start)
    pid="$(daemon_pid)"
    if pid_alive "$pid"; then
      echo "ChatGPT live collector daemon is already running (pid $pid)."
    else
      restart_app_server
    fi
    ;;
  stop)
    stop_daemon
    echo "Stopped ChatGPT live collector daemon. It will bootstrap again when ChatGPT app-server is restarted."
    ;;
  restart)
    stop_daemon
    restart_app_server
    ;;
  status)
    pid="$(daemon_pid)"
    if pid_alive "$pid"; then echo "daemon_pid=$pid running=true"; else echo "daemon_pid=${pid:-none} running=false"; fi
    if [ -f "$STATUS" ]; then cat "$STATUS"; else echo '{"state":"not-started"}'; fi
    ;;
  uninstall)
    stop_daemon
    remove_config
    restart_app_server
    echo "Removed ChatGPT live collector configuration; indexed history and sync state were preserved."
    ;;
  *) usage; exit 2 ;;
esac
